# Deployed Google Apps Script web-app URL ending in /exec.
GOOGLE_APPS_SCRIPT_URL=

# Must match the FORM_SECRET script property in Google Apps Script.
# Keep this server-side and never commit it.
GOOGLE_APPS_SCRIPT_SECRET=

# GitHub OAuth App credentials used by the Decap CMS login routes.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
